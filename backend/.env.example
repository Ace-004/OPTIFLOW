# MongoDB connection string
MONGODB_URI=
# Secret used to sign auth tokens: use a long random string
JWT_SECRET_KEY=
# Google Gemini API key (AI scoring and insights)
GEMINI_API_KEY=
# Optional. If unset or unreachable, the app runs without caching
REDIS_URL=redis://127.0.0.1:6379
# Frontend origin(s) allowed to call the API; comma-separated for several
FRONTEND_URL=http://localhost:3000
# Optional. Defaults to 5000
PORT=5000
# Set to "production" when deployed (enables secure, cross-site cookies)
NODE_ENV=development
